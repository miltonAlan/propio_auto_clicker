import pandas as pd
from datetime import datetime


def actualizar_distribucion():

    if len(historial) == 0:
        return

    # ============================
    # SOLO ULTIMAS 15 JUGADAS
    # ============================

    ultimas = historial[-10:]


    df = pd.DataFrame(
        ultimas,
        columns=["multiplicador"]
    )


    total = len(df)



    # ============================
    # CLASIFICACION
    # ============================

    menores2 = (
        df["multiplicador"] < 2
    ).sum()


    mayores2 = (
        df["multiplicador"] >= 2
    ).sum()


    grandes = (
        df["multiplicador"] >= 10
    ).sum()



    probMenor = menores2 / total * 100

    probMayor = mayores2 / total * 100

    probBig = grandes / total * 100

    # ============================
    # GUARDAR DISTRIBUCION
    # ============================

    patron_distribucion = (
        f"{probMenor:.0f},"
        f"{probMayor:.0f},"
        f"{probBig:.0f}"
    )

    if (
        len(historial_distribucion) > 0
        and historial_distribucion[-1].replace(" 🔁", "") == patron_distribucion
        ):
        patron_distribucion += " 🔁"

    historial_distribucion.append(patron_distribucion)

    # Mantener solo las últimas 10 distribuciones
    if len(historial_distribucion) > 10:
        historial_distribucion.pop(0)
    # ============================
    # RACHA ACTUAL BAJA
    # ============================

    racha_baja = 0

    for valor in reversed(historial):

        if valor < 2:
            racha_baja += 1
        else:
            break



    # ============================
    # INDICE DE POSIBLE BIG
    # ============================
    # Esto NO predice Aviator.
    # Solo mide saturacion de bajas.

    indice_big = 0


    if racha_baja >= 5:
        indice_big += 20

    if probMenor >= 70:
        indice_big += 20

    if probBig < 10:
        indice_big += 20

    if mayores2 < menores2:
        indice_big += 20


    if indice_big > 70:
        señal = "🟢 ZONA ESTADISTICA INTERESANTE"
    
    elif indice_big > 40:
        señal = "🟡 POSIBLE CAMBIO DE DISTRIBUCION"

    else:
        señal = "🔴 SIN INDICIOS"



    # ============================
    # RESULTADO
    # ============================


    print("\n" + "="*60)

    print(
        f"Ultimas {total} jugadas:"
    )

    print(ultimas)


    print("\nDISTRIBUCION:")

    print(
        f"<2x     : {probMenor:.2f}%"
    )

    print(
        f">=2x    : {probMayor:.2f}%"
    )

    print(
        f"BIG 10x+: {probBig:.2f}%"
    )

    print("\nHISTORIAL DE DISTRIBUCIONES:")

    for i, patron in enumerate(historial_distribucion, 1):
        print(f"➜ {patron}")
        
    print("\nANALISIS:")

    print(
        "Señal:",
        señal
    )


    print("="*60)



def log(action):

    print(
        f"[{datetime.now().strftime('%H:%M:%S')}] {action}"
    )


def on_press(key):

    try:

        if key == keyboard.KeyCode.from_char('x'):
            bet()
    
        if key == keyboard.KeyCode.from_char('c'):
            bet2()

        if key == keyboard.KeyCode.from_char('z'):
            data_intake()
            texto = pyperclip.paste()
            try:

                valor = float(texto)

                historial.append(valor)

                print(f"Nuevo dato: {valor}")

                actualizar_distribucion()

            except:

                print("No se pudo convertir:", texto)

    except Exception as e:
        print(e)


with keyboard.Listener(on_press=on_press) as listener:
    listener.join()